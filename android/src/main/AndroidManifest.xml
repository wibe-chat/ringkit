<!-- Plugin-provided manifest (PLAN §8.1): nothing for the app to add in the
     default setup. Every component exported="false" — PendingIntents from our
     own app don't require exported components (the incumbent exported
     everything = open attack surface, #651) — with ONE deliberate, signature-
     guarded exception: the Mode-2 RingKitMessagingReceiver (§7.3, v1.3.9), which
     must be exported="true" to receive Play Services' cross-process FCM broadcast
     and is gated by the signature-level c2dm.permission.SEND (GMS-only; R25).

     Explicitly NOT declared (§8.1): RECORD_AUDIO, CAMERA,
     FOREGROUND_SERVICE_MICROPHONE/CAMERA, ACCESS_NOTIFICATION_POLICY,
     REQUEST_IGNORE_BATTERY_OPTIMIZATIONS, WRITE_SETTINGS, custom permissions. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- §8.3 A16 promoted-ongoing opt-in (normal, install-time; inert < 36;
         user-revocable via the Live Updates toggle — never load-bearing). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- Declaration alone satisfies the phoneCall FGS-type prerequisite
         (AOSP-verified, §8.1); required by core-telecom in Phase 4. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Avatar fetch and opt-in telemetry. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Normal permission used by telemetry's unmetered-network preference. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>

        <!-- §8.1: binds to the current ringer-owner; re-binds via onNewIntent
             (launchMode singleTask — never a second instance, #550 class).
             No screenOrientation lock: Android 16 ignores it on large screens. -->
        <activity
            android:name="com.wibechat.ringkit.ui.IncomingCallActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- §8.1: translucent, showWhenLocked + turnScreenOn, null-intent-safe;
             forwards the launch intent synchronously in onCreate (§4.3). -->
        <activity
            android:name="com.wibechat.ringkit.ui.AcceptTrampolineActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- §8.1: explicit-intent only; every PI targeting it sets
             FLAG_RECEIVER_FOREGROUND (R39). -->
        <receiver
            android:name="com.wibechat.ringkit.core.CallActionReceiver"
            android:exported="false" />

        <!-- §8.1: system-protected broadcasts; runs ONLY the reconciliation
             sweep — never starts an FGS (Android 15 forbids phoneCall from
             BOOT_COMPLETED and the sweep needs none). -->
        <receiver
            android:name="com.wibechat.ringkit.core.SweepReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- §8.1: ringing FGS; lifetime per §5.2 (lives while ANY call rings). -->
        <service
            android:name="com.wibechat.ringkit.services.RingingService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="phoneCall" />

        <!-- §8.1: in-call FGS (ACCEPTED/ACTIVE/OUTGOING surfaces); default ON,
             opt-out manageOngoingCall:false. stopWithTask="false" so
             onTaskRemoved fires → ENDED(failed) + stop (an orphan "in call"
             notification is a lie). Apps holding RECORD_AUDIO may merge
             foregroundServiceType="phoneCall|microphone" onto this service;
             the mic type reaches startForeground only when declared AND
             granted (§8.1). -->
        <service
            android:name="com.wibechat.ringkit.services.OngoingCallService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="phoneCall" />

        <!-- §8.1/§10.2: API 34+ headless-delivery host. shortService needs NO
             type permission (base FOREGROUND_SERVICE suffices). START_NOT_STICKY;
             startForeground first (R16). Below 34 the durable expedited
             WorkManager fallback carries delivery — this service is never
             started there. -->
        <service
            android:name="com.wibechat.ringkit.services.EventDeliveryService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- §7.3 (v1.3.9): Mode 2 native FCM fast path. ADDITIVE c2dm receiver —
             runs in PARALLEL with firebase_messaging's own receiver, rings rk.*
             natively, and NEVER registers for MESSAGING_EVENT (so firebase_messaging
             keeps token refresh + all non-rk delivery, untouched). Ships DISABLED;
             the app opts in with one line: android:enabled="true"
             tools:replace="android:enabled". exported="true" is mandatory (the FCM
             broadcast is cross-process from GMS) but gated by the signature-level
             c2dm.permission.SEND (GMS-only) — the sole, documented carve-out to the
             exported="false" invariant (R25). firebase-messaging is compileOnly;
             consumers not enabling Mode 2 carry zero Firebase. -->
        <receiver
            android:name="com.wibechat.ringkit.fcm.RingKitMessagingReceiver"
            android:enabled="false"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
