<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application>
        <!-- DEBUG-ONLY adb trigger (CLAUDE.md cookbook): exported so
             `adb shell am broadcast` reaches it; routes through the Mode-2
             parser path (RingKitNative). Never ships in release. -->
        <receiver
            android:name=".SimulateCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.wibechat.ringkit_example.SIMULATE_CALL" />
                <action android:name="com.wibechat.ringkit_example.SIMULATE_CANCEL" />
                <action android:name="com.wibechat.ringkit_example.SIMULATE_ACTION" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
